  ],
  "jdk": {
    "minimum_major": 17,
    "maximum_major": 23,
    "note": "The range gradle must run on. The floor is the engine's gradle config, which sets sourceCompatibility and targetCompatibility to 17. The ceiling is the gradle the engine ships: gradle 8.13 cannot read a class file newer than Java 23 and fails the APK step with \"Unsupported class file major version\". The project supplies this JDK to gradle through org.gradle.java.home, written by UnRealDash_UPL.xml from UNREALDASH_JAVA_HOME, because UnrealBuildTool overwrites JAVA_HOME with the JDK bundled in Android Studio whenever its Android SDK layout check is not satisfied."
  }
}
