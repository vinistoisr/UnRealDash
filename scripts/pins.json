      "expected": "2022 Community 17.14+; both C++ workloads",
      "detect": "vs",
      "profiles": [
        "workstation",
        "android",
        "linux",
        "device"
      ],
      "minimum": "17.14",
      "product": "Microsoft.VisualStudio.Product.Community",
      "workloads": [
        "Microsoft.VisualStudio.Workload.NativeDesktop",
        "Microsoft.VisualStudio.Workload.NativeGame"
      ],
      "major": 17
    },
    {
      "id": "msvc",
      "component": "MSVC toolset",
      "expected": "14.44 (UE minimum 14.38; recommendation 14.50)",
      "detect": "msvc",
      "profiles": [
        "workstation",
        "android",
        "linux",
        "device"
      ],
      "version": "14.44"
    },
    {
      "id": "windows-sdk",
      "kits_root": null,
      "component": "Windows SDK",
      "expected": "10.0.26100",
      "detect": "windows-sdk",
      "profiles": [
        "workstation",
        "android",
        "linux",
        "device"
      ],
      "version": "10.0.26100"
    },
    {
      "id": "engine",
      "component": "Unreal Engine",
      "expected": "5.8.2, Launcher binary install",
      "detect": "engine",
      "profiles": [
        "workstation",
        "android",
        "linux",
        "device"
      ],
      "version": "5.8.2",
      "note": "Target platform support is a separate optional download and is checked per profile by the engine-android and engine-linux rows, which ask UnrealBuildTool rather than guessing from file layout. The editor ships target-platform modules for platforms it cannot build."
    },
    {
      "id": "engine-android",
      "component": "Engine Android support",
      "detect": "engine-platform",
      "expected": "UnrealBuildTool reports Android VALID",
      "profiles": [
        "android"
      ],
      "platform": "Android"
    },
    {
      "id": "engine-linux",
      "component": "Engine Linux support",
      "detect": "engine-platform",
      "expected": "UnrealBuildTool reports Linux VALID",
      "profiles": [
        "linux"
      ],
      "platform": "Linux"
    },
    {
      "id": "studio",
      "component": "Android Studio",
      "expected": "installed, with a bundled JDK (jbr)",
      "detect": "studio",
      "profiles": [
        "android"
      ],
      "note": "The engine pins the SDK platform, build-tools, cmake and NDK in Engine/Config/Android/Android_SDK.json; it does not pin an Android Studio version. Studio is required because Epic's SetupAndroid script uses its sdkmanager. Its bundled JDK is what UnrealBuildTool puts on JAVA_HOME for the APK step, and recent Studio releases bundle one newer than the engine's gradle can read, which is why the project overrides gradle's JDK rather than depending on this one. The version here is reported, not enforced."
    },
    {
      "id": "ndk",
      "component": "Android NDK",
      "expected": "the version in the engine's Android_SDK.json",
      "detect": "ndk",
      "profiles": [
        "android"
      ],
      "source": "engine-manifest"
    },
    {
      "id": "jdk",
      "component": "JDK",
      "expected": "a JDK on JAVA_HOME or the search PATH, major version 17 or newer",
      "detect": "jdk",
      "profiles": [
        "android"
      ],
      "command": "java",
      "arguments": [
        "-version"
      ],
      "minimum_major": 17,
      "note": "UnrealBuildTool rejects an Android build when the JDK on JAVA_HOME is older than 17. It does not use this JDK for gradle, so the gradle range is enforced by the project JDK row instead."
    },
    {
      "id": "project-jdk",
      "component": "Project JDK",
      "expected": "UNREALDASH_JAVA_HOME naming a JDK in the supported major-version range",
      "detect": "project-jdk",
      "profiles": [
        "android"
      ],
      "command": "java",
      "arguments": [
        "-version"
      ],
      "variable": "UNREALDASH_JAVA_HOME",
      "note": "UnRealDash_UPL.xml writes this path into gradle.properties as org.gradle.java.home, which is the only lever the project has over gradle's JDK: UnrealBuildTool overwrites JAVA_HOME with Android Studio's bundled JDK, and the engine's own JavaPath config override loses to the same substitution. The doctor reads the process value first and the stored user value second, because UnrealBuildTool resolves the variable when it processes the UPL file and was observed taking the stored value even when the launching shell exported a different one."
    },
    {
      "id": "android-sdk",
      "component": "Android SDK",
      "expected": "the platform, build-tools and cmake in the engine's Android_SDK.json",
      "detect": "android-sdk",
      "profiles": [
        "android"
      ],
      "project_settings": "The APK's targetSdkVersion and minSdkVersion are project build settings verified at task 4.1 and gated at 6.2; they are not SDK artifacts.",
      "source": "engine-manifest"
    },
    {
      "id": "linux-toolchain",
      "component": "Linux cross toolchain",
      "expected": "v26; clang 20.1.8; Rocky Linux 8; UBT only",
      "detect": "linux-toolchain",
      "profiles": [
        "linux"
      ],
      "version": "20.1.8",
      "directory": "v26_clang-20.1.8-rockylinux8"
    },
    {
      "id": "linux-root",
      "component": "LINUX_MULTIARCH_ROOT",
      "expected": "existing directory",
      "detect": "environment",
      "profiles": [
        "linux"
      ],
      "variable": "LINUX_MULTIARCH_ROOT"
    },
    {
      "id": "adb",
      "component": "ADB reachability",
      "expected": "configured device online",
      "detect": "adb",
      "profiles": [
        "device"
      ]
    },
    {
