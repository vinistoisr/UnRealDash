# Unreal generated files
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vs/
*.sln
*.suo
*.VC.db

# Local configuration and credentials
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Test output
testResults.xml

# Local CMake build directories. Anchored to the packages that create them: a bare "build/"
# also matches docs/build/, which is where the build chunk specs live.
packages/*/build/
packages/*/build-*/

# Written by the Unreal Android deploy step from engine templates
runtime/UnRealDash/Build/Android/src/

# Build-machine RHI overrides
runtime/UnRealDash/Config/Generated*.ini

# Written by the cook and package steps, not source
runtime/UnRealDash/Build/*/FileOpenOrder/

# Git Bash on Windows turns a "2>/dev/null" redirect into a literal directory
dev/

# Session scratch for build prompts and reviewer reports
scratchpad/
runtime/UnRealDash/Saved/GaugeDemo/

.tmp/
